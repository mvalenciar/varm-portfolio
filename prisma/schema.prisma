// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 🏢 1. TABLA TRAYECTORIA LABORAL (Crónicas Laborales // 職歴)
model WorkExperience {
  id          String    @id @default(uuid())
  company     String
  role        String
  description String    @db.Text
  startDate   String 
  endDate     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects    Project[]
}

// 💻 2. TABLA PROYECTOS (Obras // 作品)
model Project {
  id               String          @id @default(uuid())
  title            String 
  description      String          @db.Text
  gitHubUrl        String?
  liveUrl          String?
  isPersonal       Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workExperienceId String?
  workExperience   WorkExperience? @relation(fields: [workExperienceId], references: [id], onDelete: Cascade)

  skills           Skill[]         @relation("ProjectToSkill")
}

// 🛠️ 3. TABLA SKILLS (Habilidades // 技術)
model Skill {
  id        String    @id @default(uuid())
  name      String    @unique
  category  String
  level     Int       @default(1)
  createdAt DateTime  @default(now())

  projects  Project[] @relation("ProjectToSkill")
}

// 👤 4. TABLA PERFIL / QUIÉN SOY (プロフィール)
model Profile {
  id           String   @id @default(uuid())
  name         String   
  title        String  
  aboutMe      String   @db.Text 
  
  // Datos de Contacto Directo
  email        String
  phone        String?  
  location     String   

  // Redes y Enlaces Profesionales
  linkedInUrl  String?
  gitHubUrl    String?
  cvUrl        String?  

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 📊 5. TABLA DE ANALÍTICAS / VISITAS (アクセス解析)
model Analytics {
  id        String   @id @default(uuid())
  ipHash    String?  // Hash anónimo de la IP para auditoría de ciberseguridad
  device    String?  // Tipo de dispositivo (Mobile/Desktop)
  createdAt DateTime @default(now()) // Fecha y hora exacta de la visita
}

